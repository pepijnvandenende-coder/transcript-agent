# PostgreSQL connection string used by Prisma (schema + migrations + client).
DATABASE_URL="postgresql://user:password@localhost:5432/transcript_agent?schema=public"

# HTTP port for the Express API server.
PORT=3000

# Local filesystem root for uploaded transcripts/notes (Phase 2). Relative
# paths are resolved against the backend/ working directory.
STORAGE_ROOT_DIR=./storage

# How often the job worker (npm run worker) polls for QUEUED jobs when the
# queue is empty, in milliseconds. Not used by processNextJob() itself --
# only by the runPollingLoop() wrapper it runs on.
WORKER_POLL_INTERVAL_MS=2000
