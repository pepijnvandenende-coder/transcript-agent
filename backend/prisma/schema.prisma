generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The FSM's full state space, defined once here. Prisma generates the
// matching TypeScript enum; backend/src/workflow/states.ts re-exports it
// rather than redeclaring the same states, so the DB schema and the engine
// can never drift out of sync with each other.
enum WorkflowState {
  // Phase 19: the explicit, mandatory-but-optional-content context step that
  // now precedes transcript upload -- every workflow starts here, not at
  // CREATED. Content is never required (a user can advance with nothing
  // filled in), but the step itself can't be skipped: CREATED is only
  // reachable via the "continue_to_transcript" edge below (see
  // workflow/transitions.ts), so a workflow can never reach
  // TRANSCRIPT_UPLOADED without having passed through here first.
  CONTEXT_INPUT
  CREATED
  TRANSCRIPT_UPLOADED
  VALIDATING_TRANSCRIPT
  TRANSCRIPT_INSUFFICIENT
  PENDING_HUMAN_CONFIRMATION
  MERGING
  DETECTING_CONFLICTS
  CONFLICTS_PENDING_REVIEW
  SUGGESTING_REPORT_TYPE
  AWAITING_REPORT_TYPE_SELECTION
  GENERATING_DRAFT
  DRAFT_QUALITY_PRECHECK
  DRAFT_PENDING_REVIEW
  REVISING_DRAFT
  GENERATING_FINAL
  // Phase 18: generic follow-up phase, entered after the final report is
  // rendered and before COMPLETED. Fans out into whichever
  // post_processing_skill_policies rows are active (see that model's
  // comment) via a single job -- adding a new follow-up skill never adds a
  // new WorkflowState.
  POST_PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum WorkflowStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum JobType {
  VALIDATE_TRANSCRIPT
  MERGE
  DETECT_CONFLICTS
  SUGGEST_REPORT_TYPE
  GENERATE_DRAFT
  DRAFT_QUALITY_PRECHECK
  REVISE_DRAFT
  RENDER_FINAL
  // Phase 18: the single orchestrator job for the POST_PROCESSING state --
  // see jobs/runners/postProcessingRunner.ts.
  RUN_POST_PROCESSING
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ValidationStatus {
  VALID
  INVALID
}

enum ApprovalStatus {
  PENDING
  AUTO_APPROVED
  HUMAN_APPROVED
  HUMAN_REJECTED
}

enum PolicyType {
  AUTO_IF_ABOVE
  MANDATORY
  ADVISORY_ONLY
  AUTO
}

enum ActorType {
  SYSTEM
  USER
}

enum RetryMode {
  SAME_INPUT
  EDITED_INPUT
}

enum ApprovalRequestStatus {
  PENDING
  RESOLVED
}

enum AiOutputInputType {
  TRANSCRIPT
  NOTES
}

enum ConflictStatus {
  OPEN
  RESOLVED
}

// Phase 18: one row per (workflow, active post_processing_skill_policies key)
// pair written by jobs/runners/postProcessingRunner.ts. SKIPPED covers a
// skill whose requiresContextType has no matching context_items row for this
// workflow (e.g. CriteriaCoverage without a normenkader) -- distinct from
// FAILED (the skill ran/attempted to run and errored or produced invalid
// output), so the frontend can explain *why* a result is missing rather than
// showing a bare error.
enum PostProcessingResultStatus {
  COMPLETED
  FAILED
  SKIPPED
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String
  createdAt DateTime @default(now()) @map("created_at")

  createdWorkflows     Workflow[]        @relation("WorkflowCreatedBy")
  stateTransitions     StateTransition[]
  approvedAiOutputs    AiOutput[]
  uploadedTranscripts  Transcript[]
  uploadedNotes        Note[]
  uploadedContextItems ContextItem[]
  reviewFeedback       ReviewFeedback[]

  @@map("users")
}

model Workflow {
  id           String         @id @default(uuid())
  title        String
  currentState WorkflowState  @default(CONTEXT_INPUT) @map("current_state")
  reportType   String?        @map("report_type")
  status       WorkflowStatus @default(ACTIVE)
  createdById  String         @map("created_by")
  createdBy    User           @relation("WorkflowCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  stateTransitions      StateTransition[]
  jobs                  Job[]
  aiOutputs             AiOutput[]
  transcripts           Transcript[]
  notes                 Note[]
  contextItems          ContextItem[]
  approvalRequests      ApprovalRequest[]
  postProcessingResults PostProcessingResult[]
  merges                Merge[]
  conflicts             Conflict[]
  reportTypeSuggestions ReportTypeSuggestion[]
  drafts                Draft[]
  draftPrechecks        DraftPrecheck[]
  reviewFeedback        ReviewFeedback[]
  finalReport           FinalReport?

  @@map("workflows")
}

// The audit trail. Every FSM move -- workflow creation, a user action, or (in
// a later phase) a system event raised by the Approval Gateway -- writes
// exactly one row here. See backend/src/workflow/auditTrail.ts for the single
// write path that guarantees this.
model StateTransition {
  id         String         @id @default(uuid())
  workflowId String         @map("workflow_id")
  workflow   Workflow       @relation(fields: [workflowId], references: [id])
  fromState  WorkflowState? @map("from_state")
  toState    WorkflowState  @map("to_state")
  actorType  ActorType      @map("actor_type")
  actorId    String?        @map("actor_id")
  actor      User?          @relation(fields: [actorId], references: [id])
  aiOutputId String?        @map("ai_output_id")
  aiOutput   AiOutput?      @relation("TransitionAiOutput", fields: [aiOutputId], references: [id])
  metadata   Json?
  occurredAt DateTime       @default(now()) @map("occurred_at")

  @@map("state_transitions")
}

// Async AI task tracking. Not exercised by any Phase 1 logic (no AI calls
// exist yet) but created now per the approved architecture, ready for the
// job queue/workers introduced in a later phase.
model Job {
  id                String     @id @default(uuid())
  workflowId        String     @map("workflow_id")
  workflow          Workflow   @relation(fields: [workflowId], references: [id])
  jobType           JobType    @map("job_type")
  status            JobStatus  @default(QUEUED)
  inputRef          String?    @map("input_ref")
  outputRef         String?    @map("output_ref")
  error             String?
  attemptCount      Int        @default(0) @map("attempt_count")
  resultAiOutputId  String?    @unique @map("result_ai_output_id")
  resultAiOutput    AiOutput?  @relation("JobResultOutput", fields: [resultAiOutputId], references: [id])
  // Phase 3: set when this job was enqueued by a retry/edit-retry action at
  // PENDING_HUMAN_CONFIRMATION, rather than a fresh skill run. The runner
  // threads both through to handleSkillOutput() so it can compute the new
  // ai_outputs row's attempt_number and retry lineage.
  retryOfAiOutputId String?    @map("retry_of_ai_output_id")
  retryOfAiOutput   AiOutput?  @relation("JobRetrySource", fields: [retryOfAiOutputId], references: [id])
  retryMode         RetryMode? @map("retry_mode")
  createdAt         DateTime   @default(now()) @map("created_at")
  completedAt       DateTime?  @map("completed_at")

  producedOutputs AiOutput[] @relation("AiOutputSourceJob")

  @@map("jobs")
}

// The governance table for every AI call: schema validation status,
// confidence, approval status, and the retry lineage (attempt_number /
// retry_of_ai_output_id / retry_mode) that backs the Confirm / Retry /
// Edit-and-Retry design at PENDING_HUMAN_CONFIRMATION. Not populated by any
// Phase 1 logic (no AI calls exist yet), but created now so later phases
// don't need a schema migration to introduce it.
model AiOutput {
  id                  String           @id @default(uuid())
  jobId               String?          @map("job_id")
  job                 Job?             @relation("AiOutputSourceJob", fields: [jobId], references: [id])
  workflowId          String           @map("workflow_id")
  workflow            Workflow         @relation(fields: [workflowId], references: [id])
  skillName           String           @map("skill_name")
  promptVersion       String           @map("prompt_version")
  schemaVersion       String           @map("schema_version")
  rawOutput           Json             @map("raw_output")
  validationStatus    ValidationStatus @map("validation_status")
  validationErrors    Json?            @map("validation_errors")
  confidenceScore     Float?           @map("confidence_score")
  confidenceBreakdown Json?            @map("confidence_breakdown")
  policyApplied       PolicyType?      @map("policy_applied")
  approvalStatus      ApprovalStatus   @default(PENDING) @map("approval_status")
  approvedById        String?          @map("approved_by")
  approvedBy          User?            @relation(fields: [approvedById], references: [id])
  approvedAt          DateTime?        @map("approved_at")
  // approval_requests doesn't exist until a later phase; kept as a plain,
  // unconstrained column now per the approved architecture.
  approvalRequestId   String?          @map("approval_request_id")
  attemptNumber       Int              @default(1) @map("attempt_number")
  retryOfAiOutputId   String?          @map("retry_of_ai_output_id")
  retryOf             AiOutput?        @relation("AiOutputRetryChain", fields: [retryOfAiOutputId], references: [id])
  retries             AiOutput[]       @relation("AiOutputRetryChain")
  retryMode           RetryMode?       @map("retry_mode")
  reviewerComment     String?          @map("reviewer_comment")
  createdAt           DateTime         @default(now()) @map("created_at")

  jobResultFor          Job?                   @relation("JobResultOutput")
  retriedByJobs         Job[]                  @relation("JobRetrySource")
  stateTransitions      StateTransition[]      @relation("TransitionAiOutput")
  approvalRequests      ApprovalRequest[]
  inputs                AiOutputInput[]
  merges                Merge[]
  conflicts             Conflict[]
  reportTypeSuggestions ReportTypeSuggestion[]
  drafts                Draft[]
  draftPrechecks        DraftPrecheck[]
  finalReports          FinalReport[]
  postProcessingResults PostProcessingResult[]

  @@map("ai_outputs")
}

// Versioned, insert-only transcript uploads (Phase 2). A re-upload creates a
// new version row for the same workflow rather than overwriting the
// previous one, per the architecture doc's "regenerable inputs are
// insert-only" rule. storage_ref points at the object storage adapter
// (backend/src/storage), not a raw filesystem path.
model Transcript {
  id           String   @id @default(uuid())
  workflowId   String   @map("workflow_id")
  workflow     Workflow @relation(fields: [workflowId], references: [id])
  version      Int
  storageRef   String   @map("storage_ref")
  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([workflowId, version])
  @@map("transcripts")
}

// Same versioning rule as Transcript. Persisted starting Phase 2; not read
// by any skill until the Merger phase.
model Note {
  id           String   @id @default(uuid())
  workflowId   String   @map("workflow_id")
  workflow     Workflow @relation(fields: [workflowId], references: [id])
  version      Int
  storageRef   String   @map("storage_ref")
  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([workflowId, version])
  @@map("notes")
}

// Phase 18: generic, catalog-driven additional context (PvA, normenkader,
// vragenlijst, ... -- whatever context_type_policies rows are active),
// deliberately separate from Note/notes rather than folding Notes into this
// table: Notes already has its own first-class upload/versioning path
// (Transcript's sibling since Phase 2) that many existing flows and tests
// depend on unchanged, and duplicating that mechanism for one more type
// would be pure churn. contextType is unconstrained (no FK to
// ContextTypePolicy.key) -- same polymorphic-column pattern as
// AiOutputInput.inputId -- so a context type can be added via a catalog row
// alone, no migration. Versioned per (workflow, contextType): re-submitting
// one type creates a new version without touching any other type's history,
// unlike Note/Transcript's single global-latest version counter.
model ContextItem {
  id           String   @id @default(uuid())
  workflowId   String   @map("workflow_id")
  workflow     Workflow @relation(fields: [workflowId], references: [id])
  contextType  String   @map("context_type")
  version      Int
  storageRef   String   @map("storage_ref")
  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([workflowId, contextType, version])
  @@map("context_items")
}

// One row per open Human Approval Layer episode (Phase 2: confirm-only).
// A resolved episode is never reopened -- a later low-confidence event opens
// a new ApprovalRequest row rather than mutating this one.
model ApprovalRequest {
  id                String                @id @default(uuid())
  workflowId        String                @map("workflow_id")
  workflow          Workflow              @relation(fields: [workflowId], references: [id])
  aiOutputId        String                @map("ai_output_id")
  aiOutput          AiOutput              @relation(fields: [aiOutputId], references: [id])
  intendedNextState WorkflowState         @map("intended_next_state")
  attemptCount      Int                   @default(1) @map("attempt_count")
  status            ApprovalRequestStatus @default(PENDING)
  resolution        String?
  createdAt         DateTime              @default(now()) @map("created_at")
  resolvedAt        DateTime?             @map("resolved_at")

  @@map("approval_requests")
}

// Polymorphic lineage join: maps an ai_outputs row to the exact versioned
// input(s) it consumed. input_id intentionally has no FK -- it points into
// whichever table input_type names (Transcript today; Note and others once
// later skills consume them) -- matching the existing unconstrained-column
// pattern already used for ai_outputs.approval_request_id.
model AiOutputInput {
  id           String            @id @default(uuid())
  aiOutputId   String            @map("ai_output_id")
  aiOutput     AiOutput          @relation(fields: [aiOutputId], references: [id])
  inputType    AiOutputInputType @map("input_type")
  inputId      String            @map("input_id")
  inputVersion Int               @map("input_version")
  createdAt    DateTime          @default(now()) @map("created_at")

  @@map("ai_output_inputs")
}

// Versioned, insert-only Merger output (Phase 3) -- one row per schema-valid
// Merger attempt, regardless of eventual approval outcome, mirroring how
// ai_outputs preserves every attempt. Written by jobs/runners/mergeRunner.ts,
// not the gateway, so approval/gateway.ts stays skill-agnostic.
model Merge {
  id             String   @id @default(uuid())
  workflowId     String   @map("workflow_id")
  workflow       Workflow @relation(fields: [workflowId], references: [id])
  version        Int
  aiOutputId     String   @map("ai_output_id")
  aiOutput       AiOutput @relation(fields: [aiOutputId], references: [id])
  mergedSections Json     @map("merged_sections")
  unmatchedNotes Json     @map("unmatched_notes")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([workflowId, version])
  @@map("merges")
}

// Per-conflict rows written by jobs/runners/conflictDetectionRunner.ts when
// ConflictDetector's semantic hook fires ("conflicts found" -- see
// approval/policyResolver.ts). Never deleted: a conflict is resolved in
// place (OPEN -> RESOLVED, with resolution/resolvedBy/resolvedAt) via
// approval/conflictResolution.ts's explainConflict(), or marked RESOLVED
// with a "superseded_by_restart" resolution if the workflow restarts upload
// before every conflict is explained -- full history stays queryable either way.
model Conflict {
  id           String         @id @default(uuid())
  workflowId   String         @map("workflow_id")
  workflow     Workflow       @relation(fields: [workflowId], references: [id])
  aiOutputId   String         @map("ai_output_id")
  aiOutput     AiOutput       @relation(fields: [aiOutputId], references: [id])
  description  String
  sourceA      String?        @map("source_a")
  sourceB      String?        @map("source_b")
  status       ConflictStatus @default(OPEN)
  resolution   String?
  resolvedById String?        @map("resolved_by")
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@map("conflicts")
}

// Versioned, insert-only ReportTypeAdvisor output (Phase 5) -- one row per
// schema-valid run, mirroring Merge. Written by
// jobs/runners/suggestReportTypeRunner.ts, not the gateway. Never mutated:
// a corrected/re-run suggestion is a new row, not an overwrite of this one --
// workflows.report_type (the human's actual choice) is set separately by
// approval/reportTypeSelection.ts's selectReportType().
model ReportTypeSuggestion {
  id            String   @id @default(uuid())
  workflowId    String   @map("workflow_id")
  workflow      Workflow @relation(fields: [workflowId], references: [id])
  version       Int
  aiOutputId    String   @map("ai_output_id")
  aiOutput      AiOutput @relation(fields: [aiOutputId], references: [id])
  suggestedType String   @map("suggested_type")
  rationale     String
  runnerUp      String?  @map("runner_up")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([workflowId, version])
  @@map("report_type_suggestions")
}

// Phase 18: catalog of available additional-context types (PvA, normenkader,
// vragenlijst, ...) -- deliberately NOT hardcoded to those three examples, so
// which types are actually offered can be changed by editing catalog rows
// (isActive/sortOrder), mirroring ReportTypePolicy's "one row = one option"
// shape below. `instructionLabel` is the Dutch heading used both by the
// frontend's context step and by draftGenerationRunner.ts when it labels
// this type's content in the prompt sent to DraftGenerator -- kept separate
// from `displayName` in case a shorter list label and a fuller prompt
// heading ever need to diverge, though they start out identical.
model ContextTypePolicy {
  key              String   @id
  displayName      String   @map("display_name")
  description      String?
  instructionLabel String   @map("instruction_label")
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("context_type_policies")
}

// Phase 6: catalog of available report generation policies. Stores only
// metadata used for lookup/validation (English columns, per the codebase's
// English-only convention) -- the actual Dutch prompt instructions live in
// versioned files under src/ai/prompts/reportTypes/, referenced by
// `promptRef`, not in this table. Adding a new report type is one row here
// plus one prompt file -- no code changes to draftGenerator.ts or its runner.
model ReportTypePolicy {
  key              String   @id
  displayName      String   @map("display_name")
  language         String   @default("nl")
  promptVersion    String   @map("prompt_version")
  promptRef        String   @map("prompt_ref")
  requiredSections Json     @map("required_sections")
  optionalSections Json     @map("optional_sections")
  // Phase 14: data-driven rule for validating the body content section
  // (e.g. "Notulen") whose internal shape differs per report type --
  // {type: "topic_sections", minCount} for thematic, {type: "qa_pairs",
  // minCount} for Q&A. Keeps reportStructureValidator.ts generic so a new
  // report type stays a catalog row + prompt file, no code changes.
  bodyContentRule  Json     @map("body_content_rule")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("report_type_policies")
}

// Versioned, insert-only DraftGenerator output (Phase 6) -- one row per
// schema-valid run, mirroring Merge/ReportTypeSuggestion. Written by
// jobs/runners/draftGenerationRunner.ts, not the gateway. `sections` holds
// only the long-form Dutch content sections (Samenvatting, Notulen, ...);
// header metadata (title/attendees/date/subject) is modeled as its own
// fields since it's structurally different from prose sections.
model Draft {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id])
  version    Int
  aiOutputId String   @map("ai_output_id")
  aiOutput   AiOutput @relation(fields: [aiOutputId], references: [id])
  reportType String   @map("report_type")
  title      String
  attendees  Json
  date       String
  subject    String
  sections   Json
  coverage   Float?
  // Single source of truth for "does the source actually contain concrete
  // actions/vervolgstappen" -- set from the same DraftGenerator/DraftReviser
  // LLM call that decided whether to include the "Acties en vervolgstappen"
  // section in `sections`, so draftQualityPrecheckRunner.ts reads this
  // instead of asking the LLM a second, independent question that could
  // disagree with what was actually drafted. See draftGenerator.ts's
  // ACTIONS_SECTION_HEADING/actions_present handling.
  actionsPresent Boolean @default(false) @map("actions_present")
  createdAt  DateTime @default(now()) @map("created_at")

  draftPrechecks DraftPrecheck[]
  reviewFeedback ReviewFeedback[]
  finalReports   FinalReport[]

  @@unique([workflowId, version])
  @@map("drafts")
}

// One row per DraftQualityPrecheck run (Phase 7), referencing the Draft
// version it annotates. A separate table rather than new columns on Draft
// itself, since Draft is insert-only/never-mutated (see Draft's own comment)
// -- a precheck is metadata *about* a draft, written by a different skill,
// not a new draft content version. Written by
// jobs/runners/draftQualityPrecheckRunner.ts, not the gateway.
model DraftPrecheck {
  id             String   @id @default(uuid())
  workflowId     String   @map("workflow_id")
  workflow       Workflow @relation(fields: [workflowId], references: [id])
  draftId        String   @map("draft_id")
  draft          Draft    @relation(fields: [draftId], references: [id])
  aiOutputId     String   @map("ai_output_id")
  aiOutput       AiOutput @relation(fields: [aiOutputId], references: [id])
  overallScore   Float    @map("overall_score")
  checklist      Json
  blockingIssues Json     @map("blocking_issues")
  recommendation String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("draft_prechecks")
}

// The human's request_draft_changes feedback (Phase 7), one row per
// submission at DRAFT_PENDING_REVIEW -- becomes DraftReviser's (Phase 8)
// input. Never mutated. Written by approval/draftReview.ts's
// requestDraftChanges(), tied to the exact Draft version the feedback is
// about (a future revision loop produces new Draft versions, so feedback
// must stay pinned to what it was actually written against).
model ReviewFeedback {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  workflow    Workflow @relation(fields: [workflowId], references: [id])
  draftId     String   @map("draft_id")
  draft       Draft    @relation(fields: [draftId], references: [id])
  feedback    String
  createdById String   @map("created_by")
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("review_feedback")
}

// One row per completed workflow (Phase 9) -- COMPLETED is terminal
// (workflow/states.ts's TERMINAL_STATES) with no re-entry edge back into
// GENERATING_FINAL, so unlike Draft/Merge this is NOT versioned;
// @@unique(workflowId) enforces "at most one". Rendered content itself lives
// in object storage (storageRef), mirroring Transcript/Note's pattern -- not
// inlined as DB Json, since the download endpoint implies a real file
// artifact. Written by jobs/runners/finalRendererRunner.ts, not the gateway.
model FinalReport {
  id         String   @id @default(uuid())
  workflowId String   @unique @map("workflow_id")
  workflow   Workflow @relation(fields: [workflowId], references: [id])
  draftId    String   @map("draft_id")
  draft      Draft    @relation(fields: [draftId], references: [id])
  aiOutputId String   @map("ai_output_id")
  aiOutput   AiOutput @relation(fields: [aiOutputId], references: [id])
  title      String
  format     String   @default("markdown")
  storageRef String   @map("storage_ref")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("final_reports")
}

// Phase 18: catalog of available post-generation follow-up skills (open
// questions, norm/criteria coverage, ...) -- same "one row = one option,
// isActive toggles it, adding a row needs no code change" shape as
// ReportTypePolicy/ContextTypePolicy above. `requiresContextType` is
// optional: when set, jobs/runners/postProcessingRunner.ts skips this skill
// (writing a SKIPPED PostProcessingResult, not a failure) unless a
// context_items row of that type exists for the workflow -- e.g. norm
// coverage is meaningless without a normenkader. `promptRef` resolves via
// ai/prompts/postProcessingPromptLoader.ts, mirroring reportTypeLoader.ts.
model PostProcessingSkillPolicy {
  key                 String   @id
  displayName         String   @map("display_name")
  description         String?
  promptRef           String   @map("prompt_ref")
  requiresContextType String?  @map("requires_context_type")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("post_processing_skill_policies")
}

// Phase 18: ONE generic result table for every follow-up skill (rather than
// a dedicated open_questions/norm_coverage/... table per skill, per the
// approved design) -- `skillKey` names the PostProcessingSkillPolicy row
// that produced it (unconstrained, same polymorphic-column pattern as
// ContextItem.contextType/AiOutputInput.inputId) and `resultJson` holds
// whatever shape that skill's envelope.result actually is. Not versioned:
// POST_PROCESSING runs at most once per workflow (COMPLETED has no re-entry
// edge), same reasoning as FinalReport above. `aiOutputId` is nullable
// because a SKIPPED skill never ran, so there is no governance row for it.
model PostProcessingResult {
  id           String                     @id @default(uuid())
  workflowId   String                     @map("workflow_id")
  workflow     Workflow                   @relation(fields: [workflowId], references: [id])
  skillKey     String                     @map("skill_key")
  status       PostProcessingResultStatus
  aiOutputId   String?                    @map("ai_output_id")
  aiOutput     AiOutput?                  @relation(fields: [aiOutputId], references: [id])
  resultJson   Json?                      @map("result_json")
  errorMessage String?                    @map("error_message")
  createdAt    DateTime                   @default(now()) @map("created_at")

  @@map("post_processing_results")
}

model ApprovalPolicy {
  skillName           String     @id @map("skill_name")
  policyType          PolicyType @map("policy_type")
  confidenceThreshold Float?     @map("confidence_threshold")
  maxRetries          Int?       @default(5) @map("max_retries")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("approval_policies")
}

model SkillRegistry {
  skillName            String  @id @map("skill_name")
  currentPromptVersion String  @map("current_prompt_version")
  currentSchemaVersion String  @map("current_schema_version")
  description          String?

  @@map("skill_registry")
}
